    { "id": "s01", "narration": "अगर आप काम जानते हैं, समय भी है, फिर भी शुरू नहीं करते — तो यह वीडियो आपके लिए है।", "visual": { "type": "title", "title": "काम क्यों नहीं शुरू होता?", "badge": "हिन्दी" }, "motion": "zoom_in" },
    { "id": "s02", "narration": "दो मिनट का नियम कहता है: किसी भी काम को इतना छोटा करो कि उसे शुरू करने में दो मिनट लगे।", "visual": { "type": "stat", "value": "2 मिनट", "label": "बस शुरुआत के लिए" }, "motion": "zoom_in" },
    { "id": "s03", "narration": "पढ़ना है? बस पहला पेज खोलो। व्यायाम? बस जूते पहनो। शुरुआत होते ही रुकना मुश्किल हो जाता है।", "visual": { "type": "bullets", "heading": "आज यह कीजिए", "items": ["एक टला हुआ काम चुनिए", "उसे दो मिनट का बनाइए", "रुकने की जगह तय कीजिए"] }, "motion": "pan_left" },
    { "id": "s04", "narration": "बड़े बदलाव एक दिन में नहीं आते। वे छोटी शुरुआतों से आते हैं। आपको बस दरवाज़ा खोलना है।", "visual": { "type": "title", "title": "दरवाज़ा खोलिए", "subtitle": "बाकी रास्ता खुद बन जाएगा" }, "motion": "zoom_out" }
